  <String Id="LaunchCheckBox" Value="DBaro 실행" />
  <String Id="ExitTextWithDesktop" Value="DBaro [ProductVersion] 설치를 마쳤습니다.&#xA;&#xA;설치 위치: [INSTALLFOLDER]&#xA;바로 가기: 바탕 화면, 시작 메뉴" />
  <String Id="ExitTextNoDesktop" Value="DBaro [ProductVersion] 설치를 마쳤습니다.&#xA;&#xA;설치 위치: [INSTALLFOLDER]&#xA;바로 가기: 시작 메뉴" />
